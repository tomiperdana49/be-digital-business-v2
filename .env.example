# App Settings
PORT=3000
NODE_ENV=development

# NIS Database
DB_NIS_HOST=127.0.0.1
DB_NIS_PORT=3306
DB_NIS_USER=root
DB_NIS_PASSWORD=
DB_NIS_NAME=nis_db

# Dashboard Database
DB_DASHBOARD_HOST=127.0.0.1
DB_DASHBOARD_PORT=3306
DB_DASHBOARD_USER=root
DB_DASHBOARD_PASSWORD=
DB_DASHBOARD_NAME=dashboard_db

# Feedback (Google Sheet via Apps Script web app, lihat apps-script/feedback.gs)
FEEDBACK_APPS_SCRIPT_URL=https://script.google.com/macros/s/xxx/exec
FEEDBACK_APPS_SCRIPT_SECRET=
# Origin publik backend ini (menyajikan /api/uploads), untuk link lampiran feedback
APP_URL=http://localhost:3001
# Notifikasi feedback baru ke Google Chat (Space > Apps & integrations > Webhooks); kosong = tanpa notifikasi
FEEDBACK_GOOGLE_CHAT_WEBHOOK_URL=
# Link spreadsheet feedback, ditampilkan di notifikasi Google Chat (opsional)
FEEDBACK_SHEET_URL=

# API key client eksternal untuk /api/commission/:email (header X-API-Key), pisahkan dengan koma untuk rotasi
CLIENT_API_KEYS=
